                        }
                    }
                },
                {
                    "name": "使魔的爱",
                    "pipeline_override": {
                        "日常_使魔的爱": {
                            "enabled": true
                        },
                        "日常_使魔的爱_回列表": {
                            "enabled": true
                        },
