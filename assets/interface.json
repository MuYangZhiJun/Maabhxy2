{
    // ── 崩坏学园2 小助手 ────────────────────────────────────────────────
    // 基于 MaaFramework 的 ProjectInterface V2。
    // 重要：模拟器显示是**横屏 1280x720**（短边 720），
    //      pipeline 里的 roi 和 target 全按 1280 宽 x 720 高这个坐标系写。
    "interface_version": 2,
    "name": "崩坏学园2小助手",
    "description": "崩坏学园2（崩崩）自动化助手：图像识别 + 模拟点击。支持日常清理与重复刷关；战斗部分由 agent 的自动战斗脚本边走边打。",
    "contact": "https://github.com/MuYangZhiJun/Maabhxy2",
    "license": "MIT",
    "welcome": "首次使用请先读 README.md 的「上手四步」。已跑通的任务：启动游戏 / 领取邮件 / 领取奖励（存在感+每周任务+吼姆的礼物）/ 使魔探险 / 商店购物 / 关卡战斗（虚轴之庭 / 使魔的爱 / 活动 BONUS）/ 重复刷关。⚠️ Python 的 maafw 要和 GUI 自带的 MaaFramework 同版本（见 README）。",
    "github": "https://github.com/MuYangZhiJun/Maabhxy2",
    "version": "0.1.7",

    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],

    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "日服 / 国际服",
            "path": [
                "./resource"
            ]
        }
    ],

    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },

    "task": [
        {
            "name": "启动崩坏学园2",
            "entry": "启动游戏",
            "description": "打开崩坏学园2并自动过掉登录、公告、资源下载提示，停在主界面。跑其它任务前如果游戏没开着，先勾这个。",
            "option": [
                "游戏包名"
            ]
        },
        {
            "name": "使魔探险",
            "entry": "日常_使魔探险_入口",
            "description": "把正在进行的使魔探险奖励领掉，再把空出来的位置重新派满。建议每天跑一次，不然第二天没有已完成的探险可领。",
            "option": [
                "使魔优先派遣"
            ],
            "pipeline_override": {
                "日常_使魔探险_开面板": {
                    "enabled": true
                },
                "日常_使魔探险_已在页": {
                    "enabled": true
                },
                "日常_使魔探险_切页": {
                    "enabled": true
                },
                "日常_使魔探险_领取": {
                    "enabled": true
                },
                "日常_使魔探险_派遣": {
                    "enabled": true
                },
                "日常_派遣_一键派遣": {
                    "enabled": true
                },
                "日常_派遣_出发": {
                    "enabled": true
                },
                "日常_使魔探险_翻页": {
                    "enabled": true
                },
                "日常_使魔探险_收尾": {
                    "enabled": true,
                    "next": [
                        "日常_回主界面"
                    ]
                }
            }
        },
        {
            "name": "商店购物",
            "entry": "日常_商店购物_入口",
            "description": "进礼包商店把当天能白拿的东西买掉（不花水晶）。",
            "pipeline_override": {
                "日常_商店": {
                    "enabled": true
                },
                "日常_商店_进礼包": {
                    "enabled": true
                },
                "日常_商店_切吼美": {
                    "enabled": true
                },
                "日常_商店_翻页": {
                    "enabled": true
                },
                "日常_商店_购买": {
                    "enabled": true
                },
                "日常_商店_确认": {
                    "enabled": true
                },
                "日常_商店_确定": {
                    "enabled": true
                },
                "日常_商店_收尾": {
                    "enabled": true,
                    "next": [
                        "日常_回主界面"
                    ]
                }
            }
        },
        {
            "name": "关卡战斗",
            "entry": "关卡战斗_入口",
            "description": "把选中的关卡跑一遍，一直打到没体力为止，中途体力不够会自动兑换存着的双倍体力。",
            "option": [
                "日常模块",
                "自动模式",
                "使用双倍卷"
            ]
        },
        {
            "name": "领取奖励",
            "entry": "日常_领取奖励_入口",
            "description": "领每日存在感和每周任务里能领的奖励。",
            "option": [
                "领取奖励项目"
            ],
            "pipeline_override": {
                "日常_存在感": {
                    "enabled": true
                },
                "日常_存在感_收尾": {
                    "enabled": true
                }
            }
        },
        {
            "name": "领取邮件",
            "entry": "日常_领取邮件_入口",
            "description": "进游戏内的消息中心，按你勾的项目处理邮件。",
            "option": [
                "邮件操作"
            ],
            "pipeline_override": {
                "日常_邮件": {
                    "enabled": true
                },
                "日常_邮件_进消息": {
                    "enabled": true
                },
                "日常_邮件_收尾": {
                    "enabled": true,
                    "next": [
                        "日常_回主界面"
                    ]
                }
            }
        },        {
            "name": "重复刷关",
            "entry": "日常_重复刷关_入口",
            "description": "重复刷取BONUS关卡，用于阵营战与赌马活动，默认关闭。",
            "option": [
                "刷取次数",
                "自动模式",
                "使用双倍卷",
                "碎水晶"
            ],
            "pipeline_override": {
                "日常_活动BONUS": {
                    "enabled": true
                },
                "日常_活动BONUS_回列表": {
                    "enabled": true
                },
                "日常_活动BONUS_进活动": {
                    "enabled": true
                },
                "日常_活动BONUS_点左上": {
                    "enabled": true
                },
                "日常_活动BONUS_翻页": {
                    "enabled": true
                },
                "日常_活动BONUS_点左上2": {
                    "enabled": true
                },
                "日常_活动BONUS_选好友": {
                    "enabled": true
                },
                "日常_活动BONUS_点好友": {
                    "enabled": true
                },
                "日常_活动BONUS_开战": {
                    "enabled": true
                },
                "日常_活动BONUS_收尾": {
                    "enabled": true,
                    "next": [
                        "日常_收尾"
                    ]
                }
            }
        }
    ],

    "option": {
        "邮件操作": {
            "type": "checkbox",
            "label": "邮件要做什么",
            "description": "可多选，默认只领附件和体力。删除已读会把看过的邮件清掉，注意这个不可恢复。",
            "cases": [
                {
                    "name": "领取附件",
                    "pipeline_override": {
                        "日常_邮件_领取": {
                            "enabled": true
                        },
                        "日常_邮件_领取_关窗": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "领取体力",
                    "pipeline_override": {
                        "日常_邮件_体力": {
                            "enabled": true
                        },
                        "日常_邮件_体力_关窗": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "删除已读",
                    "pipeline_override": {
                        "日常_邮件_删除": {
                            "enabled": true
                        },
                        "日常_邮件_删除确认": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "自动读邮件",
                    "pipeline_override": {
                        "日常_邮件_读信_开始": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开1": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关1": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开2": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关2": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开3": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关3": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开4": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关4": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开5": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关5": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开6": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关6": {
                            "enabled": true
                        },
                        "日常_邮件_读信_开7": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关7": {
                            "enabled": true
                        },
                        "日常_邮件_读信_关8": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": [
                "领取附件",
                "领取体力"
            ]
        },

        "使魔优先派遣": {
            "type": "checkbox",
            "label": "优先派遣哪些等级",
            "description": "勾上的等级会优先派出去（按 S → A → B → C 的顺序找）。一个都不勾就是看到哪个派哪个。",
            "cases": [
                {
                    "name": "S 级",
                    "pipeline_override": {}
                },
                {
                    "name": "A 级",
                    "pipeline_override": {}
                },
                {
                    "name": "B 级",
                    "pipeline_override": {}
                },
                {
                    "name": "C 级",
                    "pipeline_override": {}
                }
            ],
            "default_case": []
        },

        "领取奖励项目": {
            "type": "checkbox",
            "label": "领哪些",
            "description": "想领哪个就勾哪个，默认都领。只勾一个的话，程序不会跑去另一个页面。",
            "cases": [
                {
                    "name": "每日存在感",
                    "pipeline_override": {
                        "日常_存在感": {
                            "enabled": true
                        },
                        "日常_存在感_切页": {
                            "enabled": true
                        },
                        "日常_存在感_领取": {
                            "enabled": true
                        },
                        "日常_存在感_关窗": {
                            "enabled": true
                        },
                        "日常_存在感_收尾": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "每周任务",
                    "pipeline_override": {
                        "日常_每周任务_切页": {
                            "enabled": true
                        },
                        "日常_每周任务_领取": {
                            "enabled": true
                        },
                        "日常_每周任务_关窗": {
                            "enabled": true
                        },
                        "日常_存在感_收尾": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "吼姆的礼物",
                    "pipeline_override": {
                        "日常_吼姆": {
                            "enabled": true
                        },
                        "日常_吼姆_领取": {
                            "enabled": true
                        },
                        "日常_吼姆_关窗": {
                            "enabled": true
                        },
                        "日常_吼姆_收尾": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": [
                "每日存在感",
                "每周任务",
                "吼姆的礼物"
            ]
        },

        "自动模式": {
            "type": "switch",
            "label": "自动模式",
            "description": "选项关闭时不进行操作，选项开启时自动使用一号位武器并向右走。",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "日常_活动BONUS_打完_自动": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "日常_活动BONUS_打完_挂机": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },

        "碎水晶": {
            "type": "switch",
            "label": "体力不足使用水晶补充",
            "description": "选项关闭时不进行操作，选项开启时在体力耗尽后自动花费水晶补充体力，继续刷取。",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "日常_活动BONUS_打完_自动_水晶": {
                            "enabled": true
                        },
                        "日常_活动BONUS_打完_挂机_水晶": {
                            "enabled": true
                        },
                        "日常_活动BONUS_打完_自动": {
                            "enabled": false
                        },
                        "日常_活动BONUS_打完_挂机": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "日常_活动BONUS_打完_自动_水晶": {
                            "enabled": false
                        },
                        "日常_活动BONUS_打完_挂机_水晶": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },

        "刷取次数": {
            "type": "input",
            "label": "刷取次数",
            "description": "想刷几轮就填几。一轮 = 打完一局 → 再挑战 → 选好友 → 开战。这个只给「重复刷关」用；「关卡战斗」里的关卡是刷到没体力为止，不用填。",
            "inputs": [
                {
                    "name": "次数",
                    "label": "刷几轮",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "填个正整数（1 起）"
                }
            ],
            "pipeline_override": {
                "日常_活动BONUS_打完_自动": {
                    "custom_action_param": {
                        "duration": 150,
                        "rounds": "{次数}",
                        "auto_fight": true,
                        "use_crystal": false
                    }
                },
                "日常_活动BONUS_打完_自动_水晶": {
                    "custom_action_param": {
                        "duration": 150,
                        "rounds": "{次数}",
                        "auto_fight": true,
                        "use_crystal": true
                    }
                },
                "日常_活动BONUS_打完_挂机": {
                    "custom_action_param": {
                        "duration": 150,
                        "rounds": "{次数}",
                        "auto_fight": false,
                        "use_crystal": false
                    }
                },
                "日常_活动BONUS_打完_挂机_水晶": {
                    "custom_action_param": {
                        "duration": 150,
                        "rounds": "{次数}",
                        "auto_fight": false,
                        "use_crystal": true
                    }
                }
            }
        },

        "使用双倍卷": {
            "type": "switch",
            "label": "使用双倍卷",
            "description": "选项关闭时不进行操作，选项开启时自动勾选BONUS关卡中的双倍券。",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "日常_活动BONUS_双倍券": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {}
                }
            ],
            "default_case": "No"
        },

        "游戏包名": {
            "type": "select",
            "label": "游戏包名",
            "description": "选你玩的服务器。官服是已经核实过的；玩 B 服或日服的话得自己改成对应的包名。",
            "default_case": "官服",
            "cases": [
                {
                    "name": "官服",
                    "pipeline_override": {
                        "启动游戏": {
                            "package": "com.miHoYo.HSoDv2Original"
                        }
                    }
                },
                {
                    "name": "B服",
                    "pipeline_override": {
                        "启动游戏": {
                            "package": "com.miHoYo.HSoDv2.bilibili"
                        }
                    }
                },
                {
                    "name": "日服 / 国际服",
                    "pipeline_override": {
                        "启动游戏": {
                            "package": "com.miHoYo.HSoDv2"
                        }
                    }
                }
            ]
        },

